{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leo-ppt-generator/command-result/v1",
  "type": "object",
  "required": ["protocol", "schema_version", "status", "reason_code", "artifact_refs", "evidence_refs", "warnings", "blockers", "message", "suggested_actions"],
  "properties": {
    "protocol": {"const": "leo-ppt-machine/v1"},
    "schema_version": {"const": 1},
    "status": {"enum": ["ready", "waiting_for_user", "waiting_for_worker", "blocked", "failed", "interrupted", "completed", "cancelled"]},
    "reason_code": {"type": "string", "minLength": 1},
    "message": {"type": "string", "minLength": 1},
    "suggested_actions": {"type": "array", "items": {"type": "string"}},
    "artifact_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array"},
    "blockers": {"type": "array"},
    "progress": {
      "type": ["object", "null"],
      "properties": {
        "total_units": {"type": "integer", "minimum": 0},
        "completed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "active": {"type": "integer", "minimum": 0},
        "pending": {"type": "integer", "minimum": 0},
        "estimated_remaining_seconds": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "next_action": {
      "type": "object",
      "required": ["kind"],
      "properties": {"kind": {"type": "string", "minLength": 1}},
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
