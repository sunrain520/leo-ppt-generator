{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leo-ppt-generator/credential-status/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "schema_version", "status", "reason_code", "provider", "reference_type", "credential_ref", "evidence_refs"],
  "properties": {
    "protocol": {"const": "leo-ppt-credential/v1"},
    "schema_version": {"const": 1},
    "status": {"enum": ["available", "missing"]},
    "reason_code": {"type": "string", "minLength": 1},
    "provider": {"enum": ["openai", "atlascloud", "paddleocr"]},
    "reference_type": {"enum": ["environment-reference", "os-store-reference", "none"]},
    "credential_ref": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}}
  }
}
