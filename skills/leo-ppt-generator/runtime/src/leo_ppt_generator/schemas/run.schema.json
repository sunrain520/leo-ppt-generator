{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leo-ppt-generator/run/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "route", "runtime_identity", "revision", "status", "stage", "domains", "operations"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "route": {"enum": ["generate", "direct-editable", "upgrade-full", "upgrade-selected"]},
    "runtime_identity": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 0},
    "generation": {"type": "integer", "minimum": 0},
    "leases": {"type": "object"},
    "status": {"type": "string"},
    "stage": {"type": "string"},
    "domains": {"type": "object"},
    "operations": {"type": "object"},
    "created_at": {"type": "string"},
    "output_dir": {"type": "string"},
    "idempotency_key": {"type": ["string", "null"]},
    "request_fingerprint": {"type": "string"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_path", "path", "kind", "size", "sha256", "office_trusted"],
      "properties": {
        "original_path": {"type": "string"},
        "path": {"type": "string"},
        "kind": {"enum": ["content", "image", "pdf", "office"]},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "office_trusted": {"type": "boolean"}
      }
    },
    "input_available": {"type": "boolean"},
    "prepare_disabled_reason": {"enum": ["input_removed"]},
    "backend_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "backend", "backend_kind", "model", "mode", "credential_source", "selection_source", "capabilities", "schema_version"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "backend": {"type": "string"},
        "backend_kind": {"type": "string"},
        "model": {"type": "string"},
        "mode": {"enum": ["generate", "edit"]},
        "credential_source": {"type": "string"},
        "selection_source": {"type": "string"},
        "selection": {"type": ["object", "null"]},
        "capabilities": {"type": "object"},
        "schema_version": {"const": 1}
      }
    },
    "backend_execution": {
      "type": "object",
      "required": ["receipt_hash", "receipt"],
      "properties": {
        "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "receipt": {"type": "object"}
      },
      "additionalProperties": false
    },
    "selected_pages": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "page_order": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "object"},
    "artifacts": {"type": "array"}
  }
}
