{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leo-ppt-generator/delivery/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "delivery_type", "pptx", "pptx_sha256", "pages", "failures"],
  "properties": {
    "schema_version": {"const": 1},
    "delivery_type": {"enum": ["image", "editable", "hybrid", "partial-hybrid"]},
    "pptx": {"type": "string", "minLength": 1},
    "pptx_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_id", "mode", "source_sha256", "validation_ref"],
        "properties": {
          "page_id": {"type": "string"},
          "mode": {"enum": ["image", "editable"]},
          "source_sha256": {"type": "string"},
          "validation_ref": {"type": ["string", "null"]}
        }
      }
    },
    "failures": {"type": "object", "additionalProperties": {"type": "string"}},
    "request_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_revision": {"type": "integer", "minimum": 1}
  }
}
